{
  "name": "devnonla-ui",
  "version": "0.20.3",
  "type": "module",
  "description": "NonlaUI — React controls for Nonla Agents",
  "author": "devlangla <devlangla0x01@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devnonla/devnonla-ui.git"
  },
  "homepage": "https://devnonla.github.io/devnonla-ui/",
  "bugs": {
    "url": "https://github.com/devnonla/devnonla-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown-editor/index.ts",
    "./chat": "./src/chat/index.ts",
    "./styles.css": "./src/styles.css",
    "./esm": "./dist/index.js",
    "./esm/chat": "./dist/chat/index.js",
    "./esm/markdown": "./dist/markdown-editor/index.js",
    "./esm/styles.css": "./dist/nonla-ui.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "docs": "cd docs && bun run dev",
    "build:esm": "rm -rf dist && bun build src/index.ts src/chat/index.ts src/markdown-editor/index.ts --outdir dist --root src --target browser --format esm --splitting --minify --external react --external react-dom --external react-hook-form --external 'react/*' --external 'react-dom/*'",
    "build:css": "tailwindcss -i src/standalone.css -o dist/nonla-ui.css --minify && mkdir -p dist/files && cp node_modules/@fontsource-variable/inter/files/* node_modules/@fontsource-variable/geist-mono/files/* dist/files/",
    "build": "bun run build:esm && bun run build:css",
    "check:pack": "publint --strict",
    "smoke": "bun scripts/smoke-esm.ts",
    "verify": "bun run typecheck && bunx biome check src && bun run build && bun run check:pack && bun run smoke"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.0.0"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.14.0",
    "react-day-picker": "^10.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3"
  },
  "packageManager": "bun@1.4.3"
}
